# Which database the server connects to. See backend/README.md's "Database"
# section for how this stays database-agnostic.
#
# Nothing in this backend loads a .env file automatically — this is
# documentation, not config. Export the variable yourself before running
# the server, e.g.:
#   export DATABASE_URL=sqlite:///./team_kanban.db
#   make dev
# or inline: `DATABASE_URL=... make dev`. Unset, it defaults to the value
# below anyway, so plain `make dev` is enough for local SQLite.
DATABASE_URL=sqlite:///./team_kanban.db

# Example for Postgres later (also requires installing that dialect's driver,
# e.g. `pip install psycopg`):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/team_kanban
